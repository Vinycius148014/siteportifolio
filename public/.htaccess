Options -MultiViews
RewriteEngine On
RewriteBase /

# 1) Canonical host: always non-www
RewriteCond %{HTTP_HOST} ^www\.viniciusmarchetti\.com\.br$ [NC]
RewriteRule ^ https://viniciusmarchetti.com.br%{REQUEST_URI} [R=301,L]

# 2) Canonical URL: remove explicit .html requested by browser/crawler
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html(?:[\s?]|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Canonical URL: remove trailing slash (except root "/")
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
